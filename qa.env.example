# QA Kit variables. Add these to your local .env (gitignored) next to the app's POSTGRES_* and TOKEN_SECRET.
# (This file isn't called .env.example because the repo's .gitignore ignores every .env* file.)

# Leave BASE_URL unset to test this checkout: Playwright starts the app on http://127.0.0.1:3100.
# Never point it at production (inventory.treesols.com / Supabase).
# BASE_URL=

# Demo ADMIN created by `pnpm db:seed-demo-org` against your LOCAL database.
# Seed with DEMO_ADMIN_PASSWORD set to the same value so the login is predictable.
# The seed never resets the password of a user that already exists: if you seeded before,
# use that earlier password here (or recreate the local database and seed again).
QA_USER_EMAIL=admin@trs.com
QA_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# TestRail (dedicated API user; API key from TestRail > My Settings > API Keys)
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_API_KEY=

# Optional: Slack incoming webhook for the digest
SLACK_WEBHOOK_URL=
