# Every environment variable the project reads, with example values.
# Copy to .env (gitignored) and replace the placeholders:  cp env.example .env
# (Named env.example because .gitignore ignores every .env* file.)

# ─── Runtime ─────────────────────────────────────────────────────────────────
# development | test | production — picks the block in config/config.js;
# "production" also turns on Secure cookies (lib/auth-cookies.js).
NODE_ENV=development

# ─── Database (config/config.js, mcp-server/index.js, docker-compose.yml) ────
# Local docker-compose database. For Supabase use the values in CLAUDE.md
# (POSTGRES_HOST=db.rbkipyssjjpenpohpiyl.supabase.co, POSTGRES_DB=postgres, POSTGRES_USER=postgres).
POSTGRES_DB=inventory-management-local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "true" forces SSL; it is also turned on automatically when the host contains "supabase.co".
POSTGRES_SSL=false

# ─── Auth (middlewares/auth.js, lib/page-access.js, lib/org-onboarding.js) ───
# @hapi/iron seal password: at least 32 characters. Generate one with: openssl rand -base64 48
TOKEN_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Set to "false" only to allow non-HTTPS cookies when NODE_ENV=production (e.g. `pnpm start` on localhost).
SECURE_COOKIE=true

# ─── Email: invites & sales notifications (lib/invite-email.js) ──────────────
# Resend is used if RESEND_API_KEY is set, otherwise SMTP if SMTP_HOST is set; with neither, emails are only logged.
RESEND_API_KEY=<your-resend-api-key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=<your-smtp-app-password>
# The sender address is the first one set, in this order: RESEND_EMAIL_FROM, INVITE_FROM_EMAIL, MAIL_FROM
# (default "Inventory System <no-reply@inventory.local>")
RESEND_EMAIL_FROM="Inventory System <no-reply@inventory.treesols.com>"
INVITE_FROM_EMAIL="Inventory System <no-reply@inventory.treesols.com>"
MAIL_FROM="Inventory System <no-reply@inventory.treesols.com>"
# Where new-signup and payment-request notifications go (default hammad@truerefinedsolutions.com)
SALES_NOTIFICATION_EMAIL=hammad@truerefinedsolutions.com

# ─── Billing (lib/payment-instructions.js) ───────────────────────────────────
# Multi-line text shown to orgs paying by bank transfer. Leave unset to use the
# built-in Meezan Bank details in lib/payment-instructions.js.
# BANK_PAYMENT_INSTRUCTIONS="Bank name\nAccount title: ...\nAccount no: ...\nIBAN: ..."

# ─── AI assistant (lib/claude-service.js) ────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Defaults to claude-sonnet-4-6 when unset
CLAUDE_MODEL=claude-sonnet-5-5

# ─── WhatsApp export ─────────────────────────────────────────────────────────
# Listed in CLAUDE.md but no longer read anywhere in the code (only mentioned in a comment in lib/whatsapp-share.js).
# International format with digits only, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# ─── Super admin bootstrap (pnpm db:bootstrap-super-admin) ───────────────────
SUPER_ADMIN_EMAIL=superadmin@trs.com
SUPER_ADMIN_PASSWORD=<choose-a-strong-password>
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ─── Demo org seed (pnpm db:seed-demo-org) — LOCAL database only ─────────────
# Any password left unset gets a random value. The seed never resets the password of an existing user.
DEMO_ADMIN_PASSWORD=Demo-Admin-123!
DEMO_EDITOR_WAREHOUSE_PASSWORD=Demo-Warehouse-123!
DEMO_EDITOR_SALES_PASSWORD=Demo-Sales-123!

# ─── Playwright E2E / QA Kit (playwright.config.ts, e2e/, .qa/scripts/) ──────
# Leave BASE_URL unset so Playwright starts this checkout on http://127.0.0.1:3100. Never point it at production.
# BASE_URL=http://127.0.0.1:3100
# Must match DEMO_ADMIN_PASSWORD above
QA_USER_EMAIL=admin@trs.com
QA_USER_PASSWORD=Demo-Admin-123!
# Defaults to "reports"
QA_REPORT_DIR=reports
# TestRail API user (API key from TestRail > My Settings > API Keys)
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_USER=qa-bot@example.com
TESTRAIL_API_KEY=<your-testrail-api-key>
TESTRAIL_PROJECT_NAME=inventory-system
# Optional: Slack incoming webhook for the QA digest
SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# ─── Set by CI only (GitHub Actions) — don't put these in .env ───────────────
# CI=true, GITHUB_TOKEN / GH_TOKEN, GITHUB_REPOSITORY, GITHUB_SERVER_URL, GITHUB_RUN_ID, GITHUB_OUTPUT,
# QA_RUN_TITLE, QA_LOCK_ASSERTIONS, PR_NUMBER, PR_BRANCH, PR_SHA,
# VERCEL_ORG_ID, VERCEL_PROJECT_ID (deploy.yml secrets)
