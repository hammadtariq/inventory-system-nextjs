{
  "name": "TSO Inventory (StockFlow)",
  "kitVersion": "0.5.0",
  "testDir": "e2e",
  "testrail": {
    "projectId": 1,
    "suiteId": 1,
    "templateId": 2,
    "reviewField": {
      "field": "custom_case_review_status",
      "draft": 1,
      "approved": 2
    },
    "automatedField": {
      "field": "custom_case_is_automated",
      "value": true
    }
  },
  "triage": {
    "maxFailures": 15,
    "quarantineAfter": 3,
    "flakyWindowDays": 7
  },
  "agents": {
    "toolTimeouts": {
      "browser_*": 45000,
      "browser_navigate*": 90000,
      "browser_wait_for": 60000,
      "*_setup_page": 300000,
      "test_*": 0
    }
  }
}
